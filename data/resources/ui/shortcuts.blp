using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcut window", "General");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Close Window");
      accelerator: "<ctrl>w";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Close Dialog");
      accelerator: "Escape";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcut window", "Chat List");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Search Chats");
      accelerator: "<ctrl><shift>f";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcut window", "Chat History");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Send Message");
      accelerator: "Return";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "New Line");
      accelerator: "<shift>Return";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Send Photo from Clipboard");
      accelerator: "<ctrl>v";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Leave Message Selection");
      accelerator: "Escape";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcut window", "Media Viewer");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Previous");
      accelerator: "Left";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Next");
      accelerator: "Right";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Zoom In");
      accelerator: "<ctrl>plus";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Zoom Out");
      accelerator: "<ctrl>minus";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Original Size");
      accelerator: "<ctrl>0";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Close");
      accelerator: "Escape";
    }
  }
}
