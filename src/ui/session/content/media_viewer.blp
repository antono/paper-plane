using Gtk 4.0;
using Adw 1;


template $PaplMediaViewer: Gtk.Widget {
  focusable: true;
  css-classes: ["media-viewer"];

  Adw.ToolbarView toolbar_view {
    [top]
    Adw.HeaderBar header_bar {
      css-classes: ["flat", "osd"];
      show-title: false;

      [start]
      Gtk.Button back_button {
        icon-name: "go-previous-symbolic";
        action-name: "media-viewer.close";
        tooltip-text: _("Back");
        css-classes: ["osd", "circular"];
      }

      [end]
      Gtk.Box zoom_box {
        spacing: 6;
        visible: false;

        Gtk.Button zoom_out_button {
          icon-name: "zoom-out-symbolic";
          action-name: "media-viewer.zoom-out";
          tooltip-text: _("Zoom Out");
          css-classes: ["osd", "circular"];
        }

        Gtk.Button zoom_in_button {
          icon-name: "zoom-in-symbolic";
          action-name: "media-viewer.zoom-in";
          tooltip-text: _("Zoom In");
          css-classes: ["osd", "circular"];
        }
      }
    }

    content: $PaplScaleRevealer revealer {
      child: Gtk.Overlay {
        Adw.Carousel carousel {
          hexpand: true;
          vexpand: true;
        }

        [overlay]
        Gtk.Button previous_button {
          icon-name: "go-previous-symbolic";
          halign: start;
          valign: center;
          margin-start: 12;
          css-classes: ["osd", "circular"];
          visible: false;
        }

        [overlay]
        Gtk.Button next_button {
          icon-name: "go-next-symbolic";
          halign: end;
          valign: center;
          margin-end: 12;
          css-classes: ["osd", "circular"];
          visible: false;
        }
      };
    };
  }
}
