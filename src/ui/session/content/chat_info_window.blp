using Gtk 4.0;
using Adw 1;

// An Adw.Dialog, so that the profile is a floating window on wide screens and
// a bottom sheet spanning the whole width on phones.
template $PaplChatInfoWindow : Adw.Dialog {
  styles ["chat-info"]

  EventControllerKey {
    key-pressed => $on_key_pressed() swapped;
  }

  content-width: 440;
  content-height: 720;

  child: Adw.ToastOverlay toast_overlay {
    child: Adw.ToolbarView {
      [top]
      Adw.HeaderBar {
        show-title: false;
      }

      content: ScrolledWindow scrolled_window {
        hscrollbar-policy: never;
        edge-reached => $on_edge_reached() swapped;

        child: Adw.Clamp {
          maximum-size: 640;
          tightening-threshold: 480;

          child: Box {
            styles ["main-page"]

            orientation: vertical;

            $PaplAvatar {
              size: 128;
              item: bind template.chat;
            }

            Label name_label {
              styles ["title-1"]

              wrap: true;
              wrap-mode: word_char;
              justify: center;
            }

            Inscription subtitle_label {
              text-overflow: ellipsize_middle;
              xalign: 0.5;
            }

            ListBox info_list {
              styles ["boxed-list"]

              selection-mode: none;
            }

            Box shared_media_box {
              styles ["shared-media"]

              orientation: vertical;
              visible: false;

              // The tabs scroll sideways instead of making the dialog wider
              // than a phone screen when they do not fit.
              ScrolledWindow {
                vscrollbar-policy: never;
                propagate-natural-height: true;

                child: Adw.InlineViewSwitcher {
                  stack: shared_stack;
                  display-mode: labels;
                  halign: center;
                };
              }

              Adw.ViewStack shared_stack {
                vhomogeneous: false;
                enable-transitions: true;
                notify::visible-child-name => $on_visible_page_changed() swapped;

                Adw.ViewStackPage {
                  name: "media";
                  title: _("Media");
                  visible: false;

                  child: FlowBox media_grid {
                    styles ["shared-media-grid"]

                    homogeneous: true;
                    min-children-per-line: 3;
                    max-children-per-line: 5;
                    column-spacing: 2;
                    row-spacing: 2;
                    selection-mode: none;
                    activate-on-single-click: true;
                    valign: start;
                  };
                }

                Adw.ViewStackPage {
                  name: "files";
                  title: _("Files");
                  visible: false;

                  child: ListBox files_list {
                    styles ["boxed-list"]

                    selection-mode: none;
                    valign: start;
                  };
                }

                Adw.ViewStackPage {
                  name: "links";
                  title: _("Links");
                  visible: false;

                  child: ListBox links_list {
                    styles ["boxed-list"]

                    selection-mode: none;
                    valign: start;
                  };
                }

                Adw.ViewStackPage {
                  name: "voice";
                  title: _("Voice");
                  visible: false;

                  child: ListBox voice_list {
                    styles ["boxed-list"]

                    selection-mode: none;
                    valign: start;
                  };
                }

                Adw.ViewStackPage {
                  name: "music";
                  title: _("Music");
                  visible: false;

                  child: ListBox music_list {
                    styles ["boxed-list"]

                    selection-mode: none;
                    valign: start;
                  };
                }
              }
            }
          };
        };
      };
    };
  };
}
