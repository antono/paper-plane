using Gtk 4.0;

template $PaplMessageRow {
  GestureClick {
    button: 1;
    released => $on_released() swapped;
  }

  // Selects the row in the selection mode (or with Ctrl). It runs in the
  // capture phase to claim the click before links and media see it.
  GestureClick selection_click {
    button: 1;
    propagation-phase: capture;
    pressed => $on_selection_pressed() swapped;
    released => $on_selection_released() swapped;
    cancel => $on_selection_cancelled() swapped;
  }
}
