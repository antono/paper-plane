using Gtk 4.0;

template $PaplMessageBase {
  GestureClick right_click {
    button: 3;
    propagation-phase: capture;
    pressed => $on_right_click_pressed() swapped;
    released => $on_pressed() swapped;
  }

  GestureLongPress right_long_press {
    touch-only: true;
    propagation-phase: capture;
    pressed => $on_long_pressed() swapped;
  }

  // A tap on a message opens its menu, as in Telegram for phones. It runs in
  // the bubble phase, after the links, media and buttons below.
  GestureClick tap {
    button: 1;
    touch-only: true;
    released => $on_tap_released() swapped;
  }
}
